{
  "name": "tome",
  "version": "1.5.0",
  "description": "Web fiction proxy optimized for e-ink devices",
  "author": "nmessias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmessias/tome"
  },
  "keywords": [
    "e-ink",
    "kindle",
    "kobo",
    "royal-road",
    "web-fiction",
    "reader",
    "proxy"
  ],
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/core.ts",
      "default": "./src/core.ts"
    }
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.11",
    "@kitajs/ts-html-plugin": "^4.1.3",
    "better-auth": "^1.4.9",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "tome-feature-watch": "github:eng-vmessiah/tome-feature-watch#416b2f9ac82bbd59b46645e30a9d052318683bd2",
    "tome-source-asura": "github:nmessias/tome-source-asura#ed28f1e1ca49adc9e473faa131f632bc6fd37649"
  },
  "optionalDependencies": {
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "tome-source-freewebnovel": "github:nmessias/tome-source-freewebnovel",
    "tome-source-royalroad": "github:nmessias/tome-source-royalroad#afcdf87",
    "typescript": "^5.0.0"
  }
}
