# Server port (default: 3000)
PORT=3000

# Basic Auth credentials (leave empty to disable auth)
# Required for production deployment to protect your session
AUTH_USERNAME=
AUTH_PASSWORD=

# Better Auth secret for signing sessions (required in production)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL for auth callbacks and invite links (required behind a reverse proxy,
# e.g. https://your.tome.host). When unset, Better Auth derives the origin from each
# request's Host header, which breaks invite/callback URLs behind a proxy.
BETTER_AUTH_URL=

# Source plugins (comma-separated package names, loaded at startup).
# Each package must be in dependencies (bun add <package>) and export a
# `source` (Source) and/or `feature` (Feature).
# See docs/plugins.md for the authoring guide and the plugin index in README.md.
# Examples:
# TOME_PLUGINS=tome-source-royalroad
# TOME_PLUGINS=tome-source-royalroad,tome-source-freewebnovel
TOME_PLUGINS=

# Plugin-specific variables are documented in each plugin's README
# (e.g. ROYAL_ROAD_USERNAME / ROYAL_ROAD_PASSWORD / ENABLE_BROWSER for
# tome-source-royalroad).
